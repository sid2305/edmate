{
  "name": "@edmate/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Turn pipeline and teaching engine. Imports only @edmate/contracts, zod, mathjs and its own modules (build plan rule 3).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "load-test:50": "node scripts/loadTest50.ts"
  },
  "dependencies": {
    "@edmate/contracts": "workspace:*",
    "mathjs": "15.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edmate/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
