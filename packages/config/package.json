{
  "name": "@edmate/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared tsconfig, ESLint and Prettier presets for Edmate workspaces.",
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/harness": "./eslint/harness.js",
    "./prettier": "./prettier/index.js",
    "./tsconfig/base.json": "./tsconfig/base.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.2"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
