{
  "name": "@edmate/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Model gateway: provider keys, adapters, routing, metering, caps.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate:prices": "node scripts/generate-prices.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:live": "EDMATE_LIVE_TESTS=1 vitest run -c vitest.live.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@edmate/contracts": "workspace:*",
    "ai": "7.0.143",
    "js-yaml": "5.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edmate/config": "workspace:*",
    "@edmate/harness": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "pino": "10.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
