{
  "name": "@edmate/payments",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Payments (ADR-0015): errors, webhook signature checks, the market-to-provider registry and a test fake behind the Payments port.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:live": "EDMATE_LIVE_TESTS=1 vitest run -c vitest.live.config.ts"
  },
  "dependencies": {
    "@edmate/contracts": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edmate/config": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
