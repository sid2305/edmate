{
  "name": "@edmate/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Edmate background workers (BullMQ).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "storage:roundtrip": "node dist/scripts/storage-roundtrip.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@edmate/db": "workspace:*",
    "@edmate/gateway": "workspace:*",
    "@edmate/ingest": "workspace:*",
    "@edmate/queue": "workspace:*",
    "bullmq": "6.3.16",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@edmate/config": "workspace:*",
    "@edmate/contracts": "workspace:*",
    "@edmate/harness": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
