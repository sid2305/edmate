{
  "name": "@edmate/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Edmate web app (Next.js).",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "build-smoke": "vitest run --config vitest.build-smoke.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@edmate/content": "workspace:*",
    "@edmate/contracts": "workspace:*",
    "@edmate/db": "workspace:*",
    "@edmate/queue": "workspace:*",
    "ioredis": "6.0.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "nodemailer": "8.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edmate/config": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@types/jest-axe": "3.5.9",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "jest-axe": "11.0.0",
    "jose": "6.2.12",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
