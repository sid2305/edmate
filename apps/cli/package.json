{
  "name": "@edmate/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The edmate command-line tool.",
  "bin": {
    "edmate": "./bin/edmate"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@edmate/content": "workspace:*",
    "@edmate/contracts": "workspace:*",
    "@edmate/db": "workspace:*",
    "@edmate/evals": "workspace:*",
    "@edmate/gateway": "workspace:*",
    "@edmate/harness": "workspace:*",
    "@edmate/ingest": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edmate/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
