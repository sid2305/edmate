# Azure Monitor Logs Ingestion settings for infra/azure/heartbeat.sh and infra/azure/blockers-watch.sh.
#
# Copy this file OUTSIDE the repo (the repo is public), then fill it in:
#   mkdir -p ~/.config/edmate && cp scripts/monitor.env.example ~/.config/edmate/monitor.env
#   chmod 600 ~/.config/edmate/monitor.env
# heartbeat.sh and blockers-watch.sh read ~/.config/edmate/monitor.env. Never copy a filled-in
# version into the repo: the secret scan blocks real identifiers at edit, commit and CI, and
# nothing here is needed by the product or its tests. No key or connection string belongs in this
# file either -- the Monitor write authenticates with the VM's managed identity (an IMDS token),
# never a shared key.

# All three values are printed at the end of `infra/azure/monitor-setup.sh` once it has created
# (or found) the Log Analytics workspace, Data Collection Endpoint and Data Collection Rule.

# 1. The Data Collection Endpoint's logs-ingestion URL, e.g. https://<name>.<region>-1.ingest.monitor.azure.com
EDMATE_MONITOR_DCE_ENDPOINT=

# 2. The Data Collection Rule's immutable id, e.g. dcr-0123456789abcdef0123456789abcdef
EDMATE_MONITOR_DCR_IMMUTABLE_ID=

# 3. The DCR's stream name for the EdmateHeartbeat_CL table, e.g. Custom-EdmateHeartbeat_CL
EDMATE_MONITOR_STREAM_NAME=
