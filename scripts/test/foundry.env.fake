# Fixture foundry.env for .claude/tests/test_claude_backup.py -- obviously-fake placeholder
# values, never real (mirrors infra/azure/test/monitor.env.fake's convention; scripts/ and
# docs/backup-provider.md are not in test_no_azure_identifiers.py's scan path, so no allow-list
# entry is needed here either). ANTHROPIC_FOUNDRY_API_KEY is left empty on purpose so the
# Keychain/Entra/IMDS branches are the ones actually exercised by the tests.
ANTHROPIC_FOUNDRY_RESOURCE=fake-resource
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_DEFAULT_OPUS_MODEL=fake-opus-deployment
ANTHROPIC_DEFAULT_SONNET_MODEL=fake-sonnet-deployment
ANTHROPIC_DEFAULT_HAIKU_MODEL=fake-haiku-deployment
EDMATE_BACKUP_MAIN_MODEL=fake-sonnet-deployment
