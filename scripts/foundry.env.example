# Backup model provider for the agent team: Claude models served from your Microsoft Foundry
# resource, used only when the Claude subscription window is exhausted (docs/backup-provider.md).
#
# Copy this file OUTSIDE the repo (the repo is public), then fill it in:
#   mkdir -p ~/.config/edmate && cp scripts/foundry.env.example ~/.config/edmate/foundry.env
#   chmod 600 ~/.config/edmate/foundry.env
# scripts/claude-backup.sh reads ~/.config/edmate/foundry.env. Never copy a filled-in version
# into the repo: the secret scan blocks keys at edit, commit and CI, and nothing here is needed
# by the product or its tests.

# 1. Resource name only (not a URL): the {resource} in https://{resource}.services.ai.azure.com
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name

# 2. Authentication. Pick one:
#    - API key: paste it here (the file is chmod 600 and outside the repo), or leave this empty
#      and store it in the Mac Keychain instead:
#        security add-generic-password -a "$USER" -s edmate-foundry-key -w
#    - Microsoft Entra ID: leave this empty, remove the Keychain item if any, and run `az login`.
ANTHROPIC_FOUNDRY_API_KEY=

# 3. Deployment names, exactly as created in the Foundry portal (pin a model version there,
#    never "auto-update"). Name each deployment with its model ID when you can, so Claude Code
#    recognises the model and its context window.
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5-5
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5

# 4. The main session's model while on backup. Sonnet keeps the credit for builders; set it to
#    the Opus deployment name only for a day that needs the lead at full strength.
EDMATE_BACKUP_MAIN_MODEL=claude-sonnet-5

# 5. Optional: 1-hour prompt cache (cache writes cost more, re-reads cost less; worth it for the
#    lead's long sessions, not for short fix rounds). 1 = on.
ENABLE_PROMPT_CACHING_1H=0
