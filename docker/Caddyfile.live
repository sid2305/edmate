# Live overlay (task 9.9a): the mounted Caddyfile when docker/compose.live.yaml is applied on top
# of docker/compose.yaml. Caddy's automatic HTTPS for EDMATE_PUBLIC_HOST, left on, is the whole
# point of this file. There is no load balancer or CDN in front of Caddy in this one-VM design,
# so the proxy ranges below default to loopback only (EDMATE_TRUSTED_PROXY_RANGES,
# docker/env.example); the servers block below also refuses a client-sent X-Forwarded-For, same
# reasoning as docker/Caddyfile's own comment.
{
	servers {
		trusted_proxies static {$EDMATE_TRUSTED_PROXY_RANGES}
		trusted_proxies_strict
	}
}

{$EDMATE_PUBLIC_HOST} {
	encode gzip

	reverse_proxy web:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# S3 on its own hostname, not a path on the app's site block (task 9.9c): SigV4 (the
# browser's presigned PUT and the worker's S3 client) signs the full canonical path including
# /s3/<bucket>/<key>, so a path-based proxy that strips the /s3 prefix before forwarding to MinIO
# makes the signature no longer match what MinIO sees -- 403 SignatureDoesNotMatch. sslip.io
# resolves any label prefix of an IP-based hostname, so this just works for an
# EDMATE_PUBLIC_HOST like 203-0-113-10.sslip.io; Caddy auto-issues this block its own cert the
# same as the main one. A custom (non-sslip.io) EDMATE_PUBLIC_HOST needs its own DNS record for
# this subdomain pointing at the VM. Default reverse_proxy does NOT rewrite Host, so MinIO sees
# the same Host it was signed for -- do not add header_up Host here either.
s3.{$EDMATE_PUBLIC_HOST} {
	reverse_proxy minio:9000
}
