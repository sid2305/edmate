# Single public entry point for the local stack (task 0.2). Caddy listens on :80 inside the
# container; compose publishes it on EDMATE_HTTP_PORT (default 8080). Static config: no reload.
{
	# Plain HTTP for local dev; TLS arrives with the deploy task.
	auto_https off
}

# No access log today. If one is added, it must not log the query string of
# /api/auth/callback/*: the email sign-in link's single-use token is in the query (task 1.4).
# X-Forwarded-For: reverse_proxy sets it itself; the app reads only its rightmost entry (the
# peer Caddy saw), so this holds whether Caddy replaces or appends a client-sent value.
# Production must also set trusted_proxies to whatever load balancer or CDN sits in front of
# this Caddy, or the per-IP sign-in limit collapses to one shared "unknown" bucket; see
# docs/setup/sign-in-mail-and-proxy.md.
:80 {
	encode gzip
	reverse_proxy web:3000
}
