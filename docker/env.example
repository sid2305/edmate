# Edmate local stack settings (docker/compose.yaml). Compose runs WITHOUT copying this file:
# every value below is already the built-in default, except the provider keys, which have none.
# To override, export the variable in your shell or put it in a local, gitignored env file next
# to compose.yaml. Never commit real values.
# All values here are dev-only placeholders, not secrets.

# --- Published ports (bound to 127.0.0.1) ---
# Caddy, the single entry point: curl -i localhost:8080/api/health
EDMATE_HTTP_PORT=8080
# MinIO S3 API and web console, for local tools
EDMATE_S3_PORT=9000
EDMATE_S3_CONSOLE_PORT=9001

# --- Postgres 16 + pgvector ---
POSTGRES_USER=edmate
POSTGRES_PASSWORD=edmate-dev
POSTGRES_DB=edmate
# Built by compose for web and worker from the three values above:
#   DATABASE_URL=postgres://edmate:edmate-dev@postgres:5432/edmate
# Optional pool settings read by @edmate/db (whole numbers; an invalid value fails at startup).
# Shown with their defaults and allowed ranges:
# DATABASE_POOL_MAX=10                 # 1..100 connections per process
# DATABASE_IDLE_TIMEOUT_MS=30000       # 1000..600000
# DATABASE_CONNECT_TIMEOUT_MS=5000     # 500..60000
# DATABASE_STATEMENT_TIMEOUT_MS=15000  # 100..600000 (migrations run without one)

# --- Redis (no password on the private compose network) ---
# Set by compose for web and worker: REDIS_URL=redis://redis:6379

# --- S3-compatible storage (MinIO locally; any S3 bucket in production) ---
# The access key pair doubles as MinIO's root user and password (password: 8+ characters).
S3_ACCESS_KEY_ID=edmate-dev
S3_SECRET_ACCESS_KEY=edmate-dev-storage
S3_BUCKET=edmate-dev
S3_REGION=us-east-1
# Set by compose inside the network: S3_ENDPOINT=http://minio:9000, S3_FORCE_PATH_STYLE=true.
# From the host, `corepack pnpm --filter worker storage:roundtrip` defaults to
# S3_ENDPOINT=http://localhost:9000.

# --- Model provider keys (task 2.1) ---
# No default. Local dev and tests need no key: they use the scripted gateway (build plan rule 4).
# Set a key only in your shell, a local gitignored env file or the production secret manager,
# never in the repo. Use only provider tiers that do not train on inputs. A leaked key is rotated
# at the provider, not just deleted from the file. Keys are read once at startup (restart to
# rotate). Edmate reads only these EDMATE_ names, never SDK defaults such as OPENAI_API_KEY.
# Each key needs 16+ characters.
# Anthropic, the main provider (task 2.2). Its SDK default ANTHROPIC_API_KEY is never read.
EDMATE_ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint (OpenRouter, a self-hosted server).
EDMATE_OPENAI_COMPATIBLE_API_KEY=

# --- Sign-in: Auth.js with Google (task 1.3) ---
# Read on the first sign-in request, not at startup, so /api/health works without them.
# AUTH_SECRET: 32+ random characters, for example `openssl rand -base64 32`. Never commit one.
AUTH_SECRET=
# The app's public URL. https turns on a Secure, __Host- prefixed session cookie; it is also the only
# Origin allowed on POST/PUT/PATCH/DELETE API calls. Dev default: Caddy on localhost.
AUTH_URL=http://localhost:8080
# Trust the Host header forwarded by Caddy (dev-only default; set it deliberately in production).
AUTH_TRUST_HOST=true
# Google OAuth client (Google Cloud console > Credentials). Redirect URI:
#   <AUTH_URL>/api/auth/callback/google
# Never commit real values; tests use a fake Google and need neither.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Roles are never self-assigned: everyone signs in as a student. To make the first staff account,
# sign in once, then run (after `corepack pnpm --filter @edmate/db build`):
#   corepack pnpm --filter @edmate/db db:grant-role -- --email <e> --role staff --by operator
