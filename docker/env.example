# Edmate local stack settings (docker/compose.yaml). Compose runs WITHOUT copying this file:
# every value below is already the built-in default, except the provider keys, which have none.
# To override, export the variable in your shell or put it in a local, gitignored env file next
# to compose.yaml. Never commit real values.
# All values here are dev-only placeholders, not secrets.

# --- Published ports (bound to 127.0.0.1) ---
# Caddy, the single entry point: curl -i localhost:8080/api/health
EDMATE_HTTP_PORT=8080
# MinIO S3 API and web console, for local tools
EDMATE_S3_PORT=9000
EDMATE_S3_CONSOLE_PORT=9001
# Mailpit's web UI and API (sandbox sign-in mail), http://127.0.0.1:8025
EDMATE_MAIL_UI_PORT=8025

# --- Postgres 16 + pgvector ---
POSTGRES_USER=edmate
POSTGRES_PASSWORD=edmate-dev
POSTGRES_DB=edmate
# Built by compose for web and worker from the three values above:
#   DATABASE_URL=postgres://edmate:edmate-dev@postgres:5432/edmate
# The demo seed (task 1.5; idempotent) needs DATABASE_URL set, like db:migrate. From the host,
# publish Postgres with packages/db/test/compose.port.yaml, migrate, then: corepack pnpm seed
# Optional pool settings read by @edmate/db (whole numbers; an invalid value fails at startup).
# Shown with their defaults and allowed ranges:
# DATABASE_POOL_MAX=10                 # 1..100 connections per process
# DATABASE_IDLE_TIMEOUT_MS=30000       # 1000..600000
# DATABASE_CONNECT_TIMEOUT_MS=5000     # 500..60000
# DATABASE_STATEMENT_TIMEOUT_MS=15000  # 100..600000 (migrations run without one)

# --- Redis (no password on the private compose network) ---
# Set by compose for web and worker: REDIS_URL=redis://redis:6379

# --- S3-compatible storage (MinIO locally; any S3 bucket in production) ---
# The access key pair doubles as MinIO's root user and password (password: 8+ characters).
S3_ACCESS_KEY_ID=edmate-dev
S3_SECRET_ACCESS_KEY=edmate-dev-storage
S3_BUCKET=edmate-dev
S3_REGION=us-east-1
# Set by compose inside the network: S3_ENDPOINT=http://minio:9000, S3_FORCE_PATH_STYLE=true.
# From the host, `corepack pnpm --filter worker storage:roundtrip` defaults to
# S3_ENDPOINT=http://localhost:9000.
# The web app signs browser upload URLs for S3_PUBLIC_ENDPOINT when set (compose: MinIO's
# published port). Under NODE_ENV=production the endpoint, key pair and bucket must be set and
# the endpoint must be https; compose's local stack opts out of https with S3_ALLOW_HTTP=true.

# --- Model provider keys (task 2.1) ---
# No default. Local dev and tests need no key: they use the scripted gateway (build plan rule 4).
# Set a key only in your shell, a local gitignored env file or the production secret manager,
# never in the repo. Use only provider tiers that do not train on inputs. A leaked key is rotated
# at the provider, not just deleted from the file. Keys are read once at startup (restart to
# rotate). Edmate reads only these EDMATE_ names, never SDK defaults such as OPENAI_API_KEY.
# Each key needs 16+ characters.
# Anthropic, the main provider (task 2.2). Its SDK default ANTHROPIC_API_KEY is never read.
EDMATE_ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint (OpenRouter, a self-hosted server).
EDMATE_OPENAI_COMPATIBLE_API_KEY=
# OpenAI itself (task 2.7): Whisper transcription of class recordings and the platform embedding
# model (text-embedding-3-small). Its SDK default OPENAI_API_KEY is never read.
EDMATE_OPENAI_API_KEY=

# --- Chat on the local stack (task 9.0) ---
# The market of the teacher's studio test chat only (9.4a): it picks that preview's locale pack.
# Production (the compose image) fails closed when it is unset or has no pack in content/locales/.
# A student's chat never reads it: each student's turns run in their own market, from sign-up.
EDMATE_MARKET=US
# Comma-separated agent ids students can chat with; in production an unset value means none.
EDMATE_CHAT_AGENTS=demo-agent
# Dev model, LOCAL ONLY: set to exactly `scripted` to chat with no Anthropic key. Replies start with
# "[dev model]" and quote the retrieved lesson; every safety classifier answers "all clear", so it
# is a wiring check, never a substitute for real guards or review. It works only when AUTH_URL is
# http on localhost, 127.0.0.1 or [::1]; any other AUTH_URL, or any other value, makes chat answer
# 503 (reason EDMATE_DEV_MODEL). Leave empty for real replies.
EDMATE_DEV_MODEL=
# Worker ingest (task 9.0). `off`: index uploads for full-text search only, with no embedder, no
# transcriber and no OpenAI key (audio and video then fail as unsupported). `openai`: embeddings
# and Whisper, needs EDMATE_OPENAI_API_KEY. Compose defaults to off for the local stack.
EDMATE_INGEST_EMBEDDINGS=off
# Worker web links (task 8.2e, ADR-0014). Empty: every web link is refused. `*`: any https site on
# port 443 whose DNS answers are all public addresses. Or a comma list of bare host names (exact
# match). A malformed value turns web links off (logged as a code, never the value).
EDMATE_WEB_LINK_HOSTS=*

# --- Sign-in: Auth.js with Google (task 1.3) ---
# Read on the first sign-in request, not at startup, so /api/health works without them.
# AUTH_SECRET: 32+ random characters, for example `openssl rand -base64 32`. Never commit one.
AUTH_SECRET=
# The app's public URL. https turns on a Secure, __Host- prefixed session cookie; it is also the only
# Origin allowed on POST/PUT/PATCH/DELETE API calls. Dev default: Caddy on localhost.
AUTH_URL=http://localhost:8080
# Trust the Host header forwarded by Caddy (dev-only default; set it deliberately in production).
AUTH_TRUST_HOST=true
# Google OAuth client (Google Cloud console > Credentials). Redirect URI:
#   <AUTH_URL>/api/auth/callback/google
# Never commit real values; tests use a fake Google and need neither.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Sign-in: email magic link (task 1.4) ---
# Optional, like Google; at least one of the two must be set. Email needs REDIS_URL (set by
# compose) for the per-address and per-IP request limits. Links live 15 minutes and work once.
# EMAIL_SERVER is an smtp:// or smtps:// URL, smtp(s)://user:pass@host:port. It can hold a
# password: never commit real values. Compose defaults to the Mailpit sandbox, which has no
# outbound relay:
#   EMAIL_SERVER=smtp://mailpit:1025
#   EMAIL_FROM=Edmate <sign-in@edmate.test>
# For production, export a provider's URL in your shell or secret manager only, e.g. the shape
#   smtps://REPLACE_ME_USER:REPLACE_ME_PASSWORD@smtp.provider.example:465
# Resend (human decision B-25): smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465. See
# docs/setup/sign-in-mail-and-proxy.md for the full production recipe and why compose's Mailpit
# default above must never reach production.
EMAIL_SERVER=
EMAIL_FROM=
# Sandbox recipe (email only, no Google credentials needed):
#   AUTH_SECRET=$(openssl rand -base64 32) docker compose -f docker/compose.yaml up -d --build
#   node apps/web/scripts/sandbox-magic-link.mjs
# The script requests a link for student1@example.test, reads it from Mailpit's API
# (http://127.0.0.1:8025), follows it and prints /api/auth/session.

# Roles are never self-assigned: everyone signs in as a student. To make the first staff account,
# sign in once, then run (after `corepack pnpm --filter @edmate/db build`):
#   corepack pnpm --filter @edmate/db db:grant-role -- --email <e> --role staff --by operator
